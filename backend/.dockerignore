# ==== 1. 排除开发工具与版本控制 ====
.git/               # Git 版本控制目录[1,6](@ref)
.gitignore          # Git 忽略规则文件
.mypy_cache/        # MyPy 类型检查缓存
.vscode/            # VS Code 编辑器配置[3](@ref)
.idea/              # PyCharm/IntelliJ IDE 配置[3](@ref)

# ==== 2. 排除 Python 编译缓存与虚拟环境 ====
__pycache__/        # Python 字节码缓存目录[1,6](@ref)
*.py[cod]           # 编译生成的 .pyc, .pyo, .pyd 文件
*.so                # C 扩展模块
.python-version     # pyenv 版本文件[3](@ref)
.venv/              # 虚拟环境目录（uv 默认创建）[1,3](@ref)
venv/               # 其他常见虚拟环境目录名

# ==== 3. 排除依赖管理与构建产物 ====
#uv.lock             # uv 生成的锁文件（需在 Dockerfile_bk 中显式复制）[1](@ref)
dist/               # 构建输出目录（如 wheel 包）
build/              # 编译临时目录
*.egg-info/         # Python 包元数据
*.egg               # 旧版 Python 包格式

# ==== 4. 排除敏感文件与日志 ====
.env                # 环境变量文件（可能含敏感信息）[5,6](@ref)
.secrets.*          # 所有 secrets 配置文件
*.log               # 应用日志文件[6](@ref)
logs/               # 应用日志目录

# ==== 5. 排除文档与测试文件 ====
docs/               # 文档目录
tests/              # 测试代码目录（生产镜像无需）[3](@ref)
test_*.py           # 测试脚本
*.md                # Markdown 文档（README.md 除外）[6](@ref)
!README.md          # 强制包含 README 文件（需显式说明）[6](@ref)

# ==== 6. 操作系统临时文件 ====
.DS_Store           # macOS 系统文件[1,6](@ref)
Thumbs.db           # Windows 缩略图缓存

temp_uploads/       # 临时上传文件目录
tests/