# 应用基础配置
APP_NAME="Child Development Assessment Agent"    # 应用名称
APP_VERSION="0.1.0"                             # 应用版本号
DEBUG=True                                      # 是否开启调试模式
APP_HOST="127.0.0.1"                            # 服务监听地址
APP_PORT=8000                                   # 服务监听端口
APP_RELOAD=True                                 # 是否开启自动重载（开发环境使用）

# 模型配置
DASHSCOPE_API_KEY="sk-a571867722db45bc9da8d259aea8ad4a"  # 阿里云灵积（DashScope）API密钥
MODEL_REPORT_GENERATION="qwen3.5-plus"                   # 报告生成模型
MODEL_ASSESSMENT="qwen3.5-plus"                          # 儿童发展评估模型
MODEL_VALIDATION="qwen3.5-turbo"                         # 数据校验与标准化模型
MODEL_QUERY_REWRITE="qwen3-omni-flash"                   # RAG查询重写模型
MODEL_METADATA_EXTRACTION="qwen3-omni-flash"             # 文档元数据提取模型
MODEL_VL_PARSING="qwen3-omni-flash"                # 视觉解析（扫描版PDF OCR）模型（32B以下效果最佳，7B参数）

# 日志配置
LOG_LEVEL="INFO"                                # 日志输出级别（DEBUG/INFO/WARNING/ERROR/CRITICAL）
LOG_FILE="logs/app.log"                         # 日志文件存储路径

# RAG 基础配置
RAG_HYBRID_BM25_WEIGHT=0.5                      # 混合检索中 BM25 关键词检索的权重
RAG_HYBRID_VECTOR_WEIGHT=0.5                    # 混合检索中向量语义检索的权重
BM25_SCALE_FACTOR=5                             # BM25 分数缩放因子，用于 sigmoid 校准到 [0,1] 区间（降低此值可提高校准后分数）
RAG_HYBRID_MERGE_MODE="OR"                      # 混合检索结果合并模式（OR/AND）
RAG_HYBRID_BM25_TOP_K=10                        # BM25 检索返回的最大结果数
RAG_HYBRID_VECTOR_TOP_K=10                      # 向量检索返回的最大结果数
RAG_CACHE_ENABLED=True                          # 是否开启 RAG 查询缓存
RAG_CACHE_MAX_SIZE=1000                         # RAG 缓存最大条目数
RAG_CACHE_TTL_SECONDS=3600                      # RAG 缓存过期时间（秒，默认 1 小时）
RAG_QUERY_REWRITE_ENABLED=True                  # 是否开启 RAG 查询重写优化
RAG_SIMILARITY_THRESHOLD=0.7                    # 检索结果相似度最低阈值（低于此值的结果会被过滤）
RAG_MIN_RESULT_COUNT=3                          # 检索结果最少返回条数（确保即使相似度低也返回一定数量的结果）

# RAG OCR 配置
RAG_OCR_EXTRACTION_THRESHOLD=0.5                # OCR提取率阈值（低于此值判定为扫描版PDF）
RAG_OCR_MIN_AVG_TEXT_LENGTH=100                 # OCR平均文本长度阈值（低于此值判定为扫描版PDF）

# RAG 混合检索密集模式权重（适用于文档内容密度较高的场景）
RAG_HYBRID_BM25_WEIGHT_DENSE=0.7                # 密集模式下BM25检索的权重
RAG_HYBRID_VECTOR_WEIGHT_DENSE=0.3              # 密集模式下向量检索的权重

# RAG 阈值配置
RAG_HYBRID_BASE_THRESHOLD=0.1                   # 混合检索基础阈值（低于此值的结果直接过滤）
RAG_VECTOR_BASE_THRESHOLD=0.5                   # 纯向量检索基础阈值（低于此值的结果直接过滤）
RAG_RELATIVE_CUTOFF_RATIO=0.3                   # 相对截断比例（得分低于最高分*该比例的结果会被过滤）

# RAG VL 解析配置
RAG_VL_MAX_WORKERS=4                           # VL解析最大并发线程数，阿里云API限制不超过2

# RAG 文档上传配置
RAG_UPLOAD_MAX_CONCURRENT_TASKS=5              # 文档上传处理最大并发数
RAG_TEMP_UPLOAD_DIR="./temp_uploads"           # 临时上传文件存储目录

# RAG 路径配置
RAG_STORAGE_DIR="./storage"                           # RAG索引存储目录

# RAG 分块配置
RAG_CHUNK_SIZE=800                                    # 通用文本分块大小
RAG_EPUB_CHUNK_TARGET_SIZE=1000                       # EPUB 文件分块目标大小（提高以支持更长分块）
RAG_PDF_CHUNK_SIZE=800                                # PDF 文件分块大小
RAG_CHUNK_OVERLAP=50                                  # 分块重叠字符数（提高重叠以保持上下文连续性）

# RAG 搜索配置（优化后）
RAG_SEARCH_BM25_WEIGHT=0.5                            # 内容搜索中 BM25 权重（降低，避免校准后分数过度衰减）
RAG_SEARCH_VECTOR_WEIGHT=0.5                          # 内容搜索中向量权重（提高，平衡语义匹配分数）
RAG_SEARCH_NO_MATCH_VECTOR_PENALTY=0.5                # 无关键词匹配时向量检索惩罚系数（降低惩罚力度）
RAG_SEARCH_SCORE_THRESHOLD_HYBRID=0.12                # 混合搜索得分阈值（降低以适配实际分数分布）
RAG_SEARCH_SCORE_THRESHOLD_VECTOR=0.12                # 纯向量搜索得分阈值（降低以适配实际分数分布）
RAG_SEARCH_RELATIVE_CUTOFF_RATIO=0.3                  # 搜索结果相对截断比例（保留 Top 30% 的结果）
RAG_SEARCH_MIN_SIMILARITY_THRESHOLD=0.1               # 搜索结果最小相似度阈值

# Embedding 模型配置
EMBEDDING_MODEL_NAME="text-embedding-v4"              # 嵌入模型名称
EMBEDDING_MAX_TEXT_LENGTH=1536                      # Embedding 文本最大长度（字符），超过此长度将被截断
EMBEDDING_BATCH_SIZE=10                             # Embedding 批处理大小（降低可缓解限流，默认25）

# 语义分块配置（优化：更宽松的分块策略，减少过度分割）
SEMANTIC_SPLITTER_BUFFER_SIZE=8                        # 语义分块时比较的前后段落数（增大以考虑更大上下文）
SEMANTIC_SPLITTER_BREAKPOINT_THRESHOLD=98              # 语义分块相似度阈值（百分比）（提高阈值，更不容易分割）
SEMANTIC_SPLITTER_CHAPTER_BUFFER_SIZE=5                # 长章节语义分块时比较的前后段落数（增大以考虑更大上下文）
SEMANTIC_SPLITTER_CHAPTER_BREAKPOINT_THRESHOLD=90      # 长章节语义分块相似度阈值（百分比）（提高阈值，更不容易分割）

# 向量存储配置
VECTOR_STORE_TYPE="chroma"                             # 向量存储类型: chroma, pinecone, milvus, weaviate
VECTOR_STORE_CONFIG='{"persist_dir": "./chroma_data", "collection_name": "child_development"}'  # Chroma向量存储配置

# 分层内容生成配置
RAG_LAYERED_CONTENT_ENABLED=True                       # 是否启用分层内容生成
RAG_LAYERED_CONTENT_ENABLE_LLM_GENERATION=True         # 是否启用LLM生成分层内容
RAG_LAYERED_CONTENT_ENABLE_LOCAL_FALLBACK=True         # 是否启用本地摘要兜底
RAG_LAYERED_CONTENT_L0_MAX_LENGTH=100                  # L0摘要最大长度（字符）
RAG_LAYERED_CONTENT_L1_MAX_LENGTH=500                  # L1概览最大长度（字符）
RAG_LAYERED_CONTENT_BATCH_SIZE=20                      # 分层生成默认批次大小
RAG_LAYERED_CONTENT_LARGE_BATCH_THRESHOLD=1000         # 大批次阈值（超过此值使用大批次大小）
RAG_LAYERED_CONTENT_LARGE_BATCH_SIZE=10                # 大批次时的批次大小
RAG_LAYERED_CONTENT_CONCURRENCY_LIMIT=8                # LLM 调用最大并发数

# RAG 元数据提取配置
RAG_METADATA_EXTRACTION_CONCURRENCY=50                 # 元数据提取最大并发数（提高以加速批量处理）
