# LlamaIndex Settings
LLAMA_INDEX_LOG_LEVEL=INFO

# API Keys (For embedding and other services)
DASHSCOPE_API_KEY=sk-cb0d2b50c46c4a46b67907846e05fc85
OPENAI_API_KEY=

# Application Settings
DEBUG=True
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=True
DATA_DIR=./data

# Model Names Configuration
MODEL_REPORT_GENERATION=qwen3.5-plus
MODEL_ASSESSMENT=qwen3.5-plus
MODEL_VALIDATION=qwen3.5-turbo
MODEL_QUERY_REWRITE=qwen3-omni-flash
MODEL_METADATA_EXTRACTION=qwen3-omni-flash
MODEL_VL_PARSING=qwen3-omni-flash
MODEL_QUERY_CLASSIFICATION=qwen3-omni-flash
ML_SCORING_QWEN_MODEL=qwen3.5-turbo

# RAG Basic Configuration
RAG_HYBRID_BM25_WEIGHT=0.5
RAG_HYBRID_VECTOR_WEIGHT=0.5
BM25_SCALE_FACTOR=5
RAG_HYBRID_MERGE_MODE=OR
RAG_HYBRID_BM25_TOP_K=10
RAG_HYBRID_VECTOR_TOP_K=10
RAG_CACHE_ENABLED=True
RAG_CACHE_MAX_SIZE=1000
RAG_CACHE_TTL_SECONDS=3600
RAG_QUERY_REWRITE_ENABLED=True
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MIN_RESULT_COUNT=3
RAG_STORAGE_DIR=./storage
RAG_CHUNK_SIZE=1024
RAG_EPUB_CHUNK_TARGET_SIZE=1024
RAG_PDF_CHUNK_SIZE=1536
RAG_CHUNK_OVERLAP=200
RAG_OCR_EXTRACTION_THRESHOLD=0.5
RAG_OCR_MIN_AVG_TEXT_LENGTH=100
RAG_HYBRID_BM25_WEIGHT_DENSE=0.7
RAG_HYBRID_VECTOR_WEIGHT_DENSE=0.3
RAG_HYBRID_BASE_THRESHOLD=0.1
RAG_VECTOR_BASE_THRESHOLD=0.5
RAG_RELATIVE_CUTOFF_RATIO=0.3

# RAG Search Page Configuration
RAG_SEARCH_BM25_WEIGHT=0.5
RAG_SEARCH_VECTOR_WEIGHT=0.5
RAG_SEARCH_NO_MATCH_VECTOR_PENALTY=0.5
RAG_SEARCH_SCORE_THRESHOLD_HYBRID=0.35
RAG_SEARCH_SCORE_THRESHOLD_VECTOR=0.35
RAG_SEARCH_RELATIVE_CUTOFF_RATIO=0.5
RAG_SEARCH_MIN_SIMILARITY_THRESHOLD=0.2

# RAG Age Filter Configuration
RAG_AGE_FILTER_STRICTNESS=0.7
RAG_AGE_FILTER_TOLERANCE=2
RAG_AGE_FIT_WEIGHT=0.3

# PageIndex Configuration (Currently disabled)
PAGEINDEX_ENABLED=False
PAGEINDEX_BASE_URL=https://api.pageindex.ai
PAGEINDEX_API_KEY=local-dev-key
PAGEINDEX_MAX_CONCURRENCY=5
PAGEINDEX_MAX_TREE_DEPTH=3
PAGEINDEX_TIMEOUT_SECONDS=10
PAGEINDEX_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
PAGEINDEX_CIRCUIT_BREAKER_RESET_TIMEOUT=60
PAGEINDEX_MAX_RETRIES=3
PAGEINDEX_RETRY_BASE_DELAY=0.5
PAGEINDEX_RETRY_MAX_DELAY=10.0
PAGEINDEX_FALLBACK_TO_HYBRID=True

# Query Router Configuration
QUERY_ROUTER_LLM_ENABLED=True
QUERY_ROUTER_CONFIDENCE_THRESHOLD=0.8
QUERY_ROUTER_LLM_MAX_RETRIES=2

# Result Fusion Configuration
FUSION_SCORE_BOOST_FOR_PAGEINDEX=1.2
FUSION_HYBRID_SUPPLEMENT_LIMIT=5
FUSION_DEDUP_NORMALIZE=True

# RAG Reranker Configuration
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_INITIAL_K=30
RAG_RERANKER_FINAL_K=5

# RAG Auto Persistence Configuration
RAG_AUTO_PERSIST_ENABLED=True
RAG_AUTO_PERSIST_INTERVAL=300

# RAG Performance Configuration
RAG_VL_MAX_WORKERS=2
RAG_UPLOAD_MAX_CONCURRENT_TASKS=5
RAG_TEMP_UPLOAD_DIR=./temp_uploads
RAG_METADATA_EXTRACTION_CONCURRENCY=20

# Layered Content Generation Configuration
RAG_LAYERED_CONTENT_ENABLED=True
RAG_LAYERED_CONTENT_ENABLE_LLM_GENERATION=True
RAG_LAYERED_CONTENT_ENABLE_LOCAL_FALLBACK=True
RAG_LAYERED_CONTENT_L0_MAX_LENGTH=100
RAG_LAYERED_CONTENT_L1_MAX_LENGTH=500
RAG_LAYERED_CONTENT_BATCH_SIZE=20
RAG_LAYERED_CONTENT_LARGE_BATCH_THRESHOLD=1000
RAG_LAYERED_CONTENT_LARGE_BATCH_SIZE=10
RAG_LAYERED_CONTENT_CONCURRENCY_LIMIT=8

# Embedding Configuration
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_MAX_TEXT_LENGTH=1536
EMBEDDING_BATCH_SIZE=10

# Vector Store Configuration
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_CONFIG={"persist_dir": "./storage/vector_store", "collection_name": "child_development"}

# Semantic Splitter Configuration
SEMANTIC_SPLITTER_BUFFER_SIZE=5
SEMANTIC_SPLITTER_BREAKPOINT_THRESHOLD=90
SEMANTIC_SPLITTER_CHAPTER_BUFFER_SIZE=3
SEMANTIC_SPLITTER_CHAPTER_BREAKPOINT_THRESHOLD=75

# ML Scoring Configuration
ML_SCORING_ENABLED=False
ML_SCORING_MODE=qwen
ML_SCORING_MODEL_PATH=./models/scoring_xgb.model
ML_SCORING_WEIGHT_AHP=0.7
ML_SCORING_WEIGHT_ML=0.3
