        "system prompt",
        "ignore previous",
        "forget all"
      ],
      "strict_mode_only": false
    },
    "jailbreak": {
      "name": "越狱尝试",
      "description": "尝试绕过安全限制的越狱模式",
      "regex_patterns": [
        "你现在是",
        "扮演.*角色",
        "假设你是",
        "act as",
        "pretend to be",
