    "antd": "^6.3.2",
    "axios": "^1.6.7",
    "clsx": "^2.1.1",
    "cytoscape": "^3.33.4",
    "dayjs": "^1.11.19",
    "lodash-es": "^4.17.23",
    "qs": "^6.15.1",
    "rc-field-form": "^2.7.1",
    "react": "^19.2.4",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^19.2.4",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.13.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
